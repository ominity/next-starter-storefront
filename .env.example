# -----------------------------------------------------------------------------
# Ominity API (required)
# -----------------------------------------------------------------------------
# The API key identifies the channel; its languages, countries and currencies come from /channels/current.
# Server-side only: it is never sent to the browser.
OMINITY_API_URL=https://demo.ominity.com/api
OMINITY_API_KEY=

# -----------------------------------------------------------------------------
# Sign-in (OAuth password grant)
# -----------------------------------------------------------------------------
OMINITY_AUTH_CLIENT_ID=
OMINITY_AUTH_CLIENT_SECRET=
OMINITY_AUTH_SCOPE=
# Encrypts the session cookie; at least 32 characters.
OMINITY_AUTH_SESSION_SECRET=change-me-with-32-plus-characters

# When true, checkout also works without signing in.
OMINITY_CHECKOUT_ALLOW_GUEST=true

# -----------------------------------------------------------------------------
# Routing / locales
# -----------------------------------------------------------------------------
# none | language | country-language
OMINITY_LOCALE_SEGMENT_STRATEGY=language
# if-not-canonical | never
OMINITY_CANONICAL_REDIRECT_POLICY=if-not-canonical
# localize-relative | passthrough
OMINITY_STRING_LINK_STRATEGY=localize-relative
# Locale redirect for `/`: off | accept-language | cookie-accept-language | geo-cookie-accept-language
OMINITY_HOME_LOCALE_REDIRECT_MODE=off
OMINITY_HOME_LOCALE_REDIRECT_COOKIE_NAME=ominity_locale
OMINITY_HOME_LOCALE_REDIRECT_SKIP_BOTS=true
OMINITY_TRAILING_SLASH=false
OMINITY_BASE_PATH=

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OMINITY_TRACKING_ENABLED=false
OMINITY_DEBUG_LOGS=false
OMINITY_DEV_TOOL=true
# Throw on CMS components without a registered renderer (false shows a placeholder).
OMINITY_STRICT_COMPONENTS=true
# Secret for /api/draft?secret=… (CMS previews).
OMINITY_DRAFT_TOKEN=change-me
# Validate form IDs with @ominity/api-module-forms before forwarding submissions.
OMINITY_FORMS_VALIDATE_FORM_ID=true
